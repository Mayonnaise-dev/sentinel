# CS2 Server RCON Configuration
RCON_HOST=192.168.1.50
RCON_PORT=27015
RCON_PASS=your_rcon_password_here

# Monitoring Configuration
CHECK_INTERVAL=60

# Allowed Countries (comma-separated country codes, no spaces)
# Example: ZA,US,GB
ALLOWED_COUNTRIES=ZA

# Whitelist Steam IDs (comma-separated, no spaces)
# Use Steam3 ID format: 12345678 (the number from [U:1:12345678])
# Find your Steam ID at: https://steamid.io/
WHITELIST_STEAMIDS=
